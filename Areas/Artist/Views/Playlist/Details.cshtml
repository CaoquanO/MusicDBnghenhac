@model MusicDBApp.Models.Playlist

@{
    ViewData["Title"] = Model.PlaylistName;
    Layout = "~/Views/Shared/_ArtistLayout.cshtml";
}

<style>
    .playlist-detail-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #121212;
        overflow: hidden;
        color: white;
    }


    .playlist-header {
        flex: 0 0 auto;
        background: linear-gradient(to bottom, #505050, #121212);
        padding: 30px 40px;
        display: flex;
        align-items: flex-end;
        gap: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        z-index: 2;
    }

    .playlist-cover-icon {
        width: 180px;
        height: 180px;
        background: #282828;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 80px;
        box-shadow: 0 4px 60px rgba(0,0,0,0.5);
        border-radius: 4px;
    }

    .playlist-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px 40px;
        position: relative;
    }

        .playlist-content::-webkit-scrollbar {
            width: 8px;
        }

        .playlist-content::-webkit-scrollbar-track {
            background: #121212;
        }

        .playlist-content::-webkit-scrollbar-thumb {
            background: #555;
            border-radius: 4px;
        }

            .playlist-content::-webkit-scrollbar-thumb:hover {
                background: #888;
            }

    .action-bar {
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .btn-play-big {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background-color: #1DB954;
        border: none;
        color: black;
        font-size: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

        .btn-play-big:hover {
            transform: scale(1.05);
            background-color: #1ed760;
        }

    .btn-add-song-outline {
        border: 1px solid #777;
        color: white;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 1px;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-add-song-outline:hover {
            border-color: white;
            background: rgba(255,255,255,0.1);
            color: white;
            transform: scale(1.05);
        }

    .table-spacious {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
        margin-bottom: 150px;
    }

        .table-spacious thead th {
            color: #b3b3b3;
            font-weight: normal;
            text-transform: uppercase;
            font-size: 12px;
            padding-bottom: 10px;
            border-bottom: 1px solid #333;
            text-align: left;
        }

        .table-spacious tbody tr {
            background-color: transparent;
            transition: background-color 0.2s;
            border-radius: 5px;
        }

            .table-spacious tbody tr:hover {
                background-color: #2a2a2a;
            }

        .table-spacious td {
            padding: 10px 15px;
            vertical-align: middle;
            color: #fff;
        }

        .table-spacious tbody td:first-child {
            border-top-left-radius: 5px;
            border-bottom-left-radius: 5px;
        }

        .table-spacious tbody td:last-child {
            border-top-right-radius: 5px;
            border-bottom-right-radius: 5px;
        }

    .btn-remove-tiny {
        color: #b3b3b3;
        font-size: 12px;
        text-decoration: none;
        padding: 5px 10px;
        border: 1px solid transparent;
        border-radius: 20px;
        transition: 0.2s;
    }

        .btn-remove-tiny:hover {
            color: #ff5555;
            border-color: #ff5555;
            background: rgba(255, 85, 85, 0.1);
        }

</style>

<div class="playlist-detail-page">

    <div class="playlist-header">
        <div class="playlist-cover-icon">
            🎵
        </div>
        <div>
            <small class="fw-bold text-uppercase">Playlist</small>
            <h1 style="font-size: 60px; font-weight: 900; margin: 5px 0 15px 0; line-height: 1;">@Model.PlaylistName</h1>
            <p class="text-white-50 m-0" style="font-size: 14px;">
                <span class="text-white fw-bold">Admin</span> •
                @Model.Songs.Count bài hát •
                Tạo ngày @Model.CreateDate?.ToString("dd/MM/yyyy")
            </p>
        </div>
    </div>

    <div class="playlist-content">

        <div class="action-bar">
            <button class="btn-play-big">
                <i class="fa fa-play" style="margin-left: 5px;">▶</i>
            </button>

            <a href="/Artist/Playlist/SelectSong?playlistId=@Model.PlaylistId"
               class="btn-add-song-outline">
                Thêm bài hát mới
            </a>
        </div>

        <table class="table-spacious">
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 40%;">Tiêu đề</th>
                    <th style="width: 30%;">Ca sĩ</th>
                    <th style="width: 15%;">Thời lượng</th>
                    <th style="width: 10%;" class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @if (Model.Songs != null && Model.Songs.Any())
                {
                    @foreach (var song in Model.Songs)
                    {
                        <tr>
                            <td class="text-white-50">@i</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@song.SongImage" width="45" height="45" style="object-fit:cover; margin-right:15px; border-radius: 4px;">
                                    <div>
                                        <div class="fw-bold text-white" style="font-size: 15px;">@song.SongName</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-white-50">@song.Artist?.ArtistName</td>
                            <td class="text-white-50">@song.Duration</td>
                            <td class="text-end">
                                <a href="/Artist/Playlist/RemoveSong?playlistId=@Model.PlaylistId&songId=@song.SongId"
                                   class="btn-remove-tiny">
                                    Gỡ bỏ
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                }
            </tbody>
        </table>

    </div>
</div>