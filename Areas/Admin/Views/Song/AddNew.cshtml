@model MusicDBApp.Models.Song
@{
    ViewData["Title"] = "Add New Song";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .song-form-container {
        max-width: 700px;
        margin: 40px auto;
        background-color: #1e1e1e;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        color: #fff;
    }

        .song-form-container h2 {
            margin-bottom: 25px;
            font-size: 28px;
            font-weight: 600;
            color: #1db954;
            text-align: center;
        }

        .song-form-container table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 15px;
        }

        .song-form-container td:first-child {
            width: 35%;
            font-weight: 500;
            color: #ccc;
            padding-right: 10px;
            vertical-align: middle;
        }

        .song-form-container input,
        .song-form-container select {
            width: 100%;
            padding: 10px 12px;
            background-color: #121212;
            border: 1px solid #333;
            border-radius: 6px;
            color: #fff;
            font-size: 14px;
        }

            .song-form-container input:focus,
            .song-form-container select:focus {
                outline: none;
                border-color: #1db954;
                box-shadow: 0 0 0 2px rgba(29,185,84,0.25);
            }

            .song-form-container input[type="file"] {
                padding: 6px;
                background-color: #121212;
            }

        .song-form-container button {
            margin-top: 25px;
            width: 100%;
            padding: 12px;
            background-color: #1db954;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.25s ease;
        }

            .song-form-container button:hover {
                background-color: #17a74a;
            }
</style>

<div class="song-form-container">
    <h2>Thêm bài hát mới</h2>

    <form asp-action="AddNew" method="post" enctype="multipart/form-data">
        <table>
            <tr>
                <td>Song Name</td>
                <td><input asp-for="SongName" required /></td>
            </tr>

            <tr>
                <td>Duration</td>
                <td><input asp-for="Duration" type="string" required /></td>
            </tr>

            <tr>
                <td>Category</td>
                <td><input asp-for="Category" required /></td>
            </tr>

            <tr>
                <td>Artist</td>
                <td>
                    <select asp-for="ArtistId"
                            asp-items="@(new SelectList(ViewBag.Artists, "ArtistId", "ArtistName"))"
                            required>
                        <option value="">-- Chọn nghệ sĩ --</option>
                    </select>
                </td>
            </tr>

            <tr>
                <td>Song File</td>
                <td><input type="file" name="uploadFile" accept=".mp3,.wav" /></td>
            </tr>

            <tr>
                <td>Song Image</td>
                <td><input type="file" name="uploadImage" accept=".jpg,.png,.jpeg" /></td>
            </tr>
        </table>

        <button type="submit">Add Song</button>
    </form>
</div>
@section Scripts {
    <script src="~/js/listsong.js"></script>
    <script src="~/js/listsong2.js"></script>
    <script src="~/js/music-player.js"></script>
    <script src="~/js/timeprogress.js"></script>

}