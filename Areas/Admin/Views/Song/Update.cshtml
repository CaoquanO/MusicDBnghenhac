@model MusicDBApp.Models.Song
@{
    ViewData["Title"] = "Update Song";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>

    .song-form-container {
        max-width: 820px;
        margin: 30px auto;
        background-color: #1e1e1e;
        padding: 25px 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        color: #fff;
    }

        .song-form-container h2 {
            text-align: center;
            color: #1db954;
            margin-bottom: 20px;
        }

    /* 🔥 CHỈ PHẦN BẢNG ĐƯỢC SCROLL */
    .table-scroll {
        max-height: 55vh;
        overflow-y: auto;
        padding-right: 10px;
    }

        /* Ẩn scrollbar */
        .table-scroll::-webkit-scrollbar {
            width: 0;
        }

    .table-scroll {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 15px;
    }

    td:first-child {
        width: 35%;
        color: #ccc;
        font-weight: 500;
        vertical-align: top;
    }

    input, select {
        width: 100%;
        padding: 10px;
        background-color: #121212;
        border: 1px solid #333;
        border-radius: 6px;
        color: white;
    }

    audio {
        width: 100%;
        margin-top: 6px;
    }

    img {
        margin-top: 6px;
        border-radius: 8px;
    }

    .hint {
        font-size: 13px;
        color: #aaa;
        margin-top: 5px;
    }

    .btn-submit {
        margin-top: 20px;
        width: 100%;
        padding: 12px;
        background-color: #1db954;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-submit:hover {
            background-color: #17a74a;
        }
</style>

<div class="song-form-container">
    <h2>Cập nhật bài hát</h2>

    <form asp-action="Update" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="SongId" />

 
        <div class="table-scroll">
            <table>
                <tr>
                    <td>Song Name</td>
                    <td><input asp-for="SongName" required /></td>
                </tr>

                <tr>
                    <td>Duration (seconds)</td>
                    <td><input asp-for="Duration" type="string" required /></td>
                </tr>

                <tr>
                    <td>Category</td>
                    <td><input asp-for="Category" required /></td>
                </tr>

                <tr>
                    <td>Artist</td>
                    <td>
                        <select asp-for="ArtistId"
                                asp-items="@(new SelectList(ViewBag.Artists, "ArtistId", "ArtistName"))"
                                required>
                        </select>
                    </td>
                </tr>

                <!-- FILE NHẠC HIỆN TẠI -->
                <tr>
                    <td>Current Song</td>
                    <td>
                        @if (!string.IsNullOrEmpty(Model.FilePath))
                        {
                            <audio controls>
                                <source src="~/song/@Model.FilePath" type="audio/mpeg" />
                            </audio>
                            <div class="hint">Để trống nếu không muốn đổi file</div>
                        }
                        else
                        {
                            <span class="hint">Chưa có file nhạc</span>
                        }
                    </td>
                </tr>

                <!-- ĐỔI FILE NHẠC -->
                <tr>
                    <td>Change Song File</td>
                    <td>
                        <input type="file" name="uploadFile" accept="audio/*" />
                    </td>
                </tr>

                <!-- HÌNH ẢNH HIỆN TẠI -->
                <tr>
                    <td>Current Image</td>
                    <td>
                        @if (!string.IsNullOrEmpty(Model.SongImage))
                        {
                            <img src="@Model.SongImage" width="150" />
                            <div class="hint">Để trống nếu không muốn đổi ảnh</div>
                        }
                        else
                        {
                            <span class="hint">Chưa có hình ảnh</span>
                        }
                    </td>
                </tr>

                <!-- ĐỔI ẢNH -->
                <tr>
                    <td>Change Image</td>
                    <td>
                        <input type="file" name="uploadImage" accept="image/*" />
                    </td>
                </tr>
            </table>
        </div>

        <!-- NÚT LUÔN THẤY -->
        <button type="submit" class="btn-submit">Update Song</button>
    </form>
</div>
@section Scripts {
    <script src="~/js/listsong.js"></script>
    <script src="~/js/listsong2.js"></script>
    <script src="~/js/music-player.js"></script>
    <script src="~/js/timeprogress.js"></script>

}
