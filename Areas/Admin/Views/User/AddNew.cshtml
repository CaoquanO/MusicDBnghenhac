@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    <style>
        .sidebar div a:nth-child(5) {
            color: #ffff;
        }
    </style>
}
<style>
    h2 {
        color: #fff;
        font-size: 28px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    form {
        background-color: #1e1e1e;
        padding: 25px;
        border-radius: 10px;
        max-width: 800px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.7);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        background-color: #272727;
        color: #1db954;
        text-transform: uppercase;
        font-size: 14px;
        letter-spacing: 1px;
        padding: 12px;
        text-align: left;
    }

    tbody tr {
        border-bottom: 1px solid #333;
    }

        tbody tr:last-child {
            border-bottom: none;
        }

    td {
        padding: 14px 10px;
        color: #ddd;
        vertical-align: middle;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    select {
        width: 100%;
        padding: 10px 12px;
        background-color: #121212;
        color: #fff;
        border: 1px solid #333;
        border-radius: 6px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    input::placeholder {
        color: #777;
    }

    input:focus,
    select:focus {
        border-color: #1db954;
        box-shadow: 0 0 0 1px #1db95455;
    }

    select option {
        background-color: #1e1e1e;
        color: #fff;
    }

    button[type="submit"] {
        margin-top: 20px;
        background-color: #1db954;
        color: #fff;
        padding: 12px 22px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.15s;
    }

        button[type="submit"]:hover {
            background-color: #17a44b;
            transform: translateY(-1px);
        }

        button[type="submit"]:active {
            transform: translateY(0);
        }
</style>
@model MusicDBApp.Models.User
<h2>Thêm người dùng mới</h2>
<form asp-action="AddNew" asp-controller="User" method="post">
    <!-- Thay đổi action theo route của bạn -->
    <table>
        <thead>
            <tr>
                <th>Field</th>
                <th>Input</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>User Name</td>
                <td><input type="text" name="UserName" placeholder="Enter User Name" required /></td>
            </tr>
            <tr>
                <td>Email</td>
                <td><input type="email" name="Email" placeholder="Enter Email" required /></td>
            </tr>
            <tr>
                <td>Full Name</td>
                <td><input type="text" name="FullName" placeholder="Enter Full Name" required /></td>
            </tr>
            <tr>
                <td>Password</td>
                <td><input type="password" name="Password" placeholder="Enter Password" required /></td>
            </tr>
            <tr>
                <td>Role</td>
                <td>
                    <select name="RoleId" required>
                        <option value="">-- Chọn vai trò --</option>
                        <option value="Admin">Quản trị viên</option>
                        <option value="Artist">Nghệ sĩ</option>
                        <option value="User">Người dùng</option>
                    </select>
                </td>
            </tr>
        </tbody>
    </table>
    <br>
    <button type="submit">Add User</button>
</form>